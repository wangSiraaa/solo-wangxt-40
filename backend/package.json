{
  "name": "royalty-splitter-backend",
  "version": "1.0.0",
  "private": true,
  "description": "可复核的独立音乐分账核算服务 (NestJS + PostgreSQL + decimal.js)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:start": "ts-node scripts/local-pg.ts initdb",
    "db:stop": "ts-node scripts/local-pg.ts stop",
    "db:reset": "ts-node scripts/seed.ts --reset",
    "seed": "ts-node scripts/seed.ts",
    "demo": "ts-node scripts/seed.ts --reset --import",
    "e2e": "ts-node scripts/e2e-check.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^5.5.0",
    "decimal.js": "^10.4.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.5",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "^17.10.0-beta.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
